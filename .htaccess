# PlastiLink root .htaccess
# Lets the app run from http://localhost/PlastiLink/ under XAMPP (no vhost needed).
# On Hostinger, point the domain's document root at /public instead (see README).

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve application internals or tooling
    RewriteRule ^(app|config|database|storage|resources|routes|tests|deploy|docs)(/|$) - [F,L]
    RewriteRule ^(migrate|seed|jobs|backup|create-admin)\.php$ - [F,L]
    RewriteRule ^(README\.md|CHANGELOG\.md|composer\..*)$ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule \.(sql|gz|enc|zip|bak|log|env|ini|example)$ - [F,L]

    # The app is only reachable at its normal address, never under /public/ (checked on the ORIGINAL request, so the internal rewrite below still works)
    RewriteCond %{THE_REQUEST} "^[A-Z]{3,7} /(?:[^/ ?]+/)*public(?:[/? ]|$)"
    RewriteRule ^ - [F,L]

    # Everything else is served from /public
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
